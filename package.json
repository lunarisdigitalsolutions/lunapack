{
  "name": "@lunaris/lunapack",
  "version": "0.1.0",
  "private": true,
  "description": "LunaPack is a CLI for managing and consuming packs of reusable content.",
  "scripts": {
    "cli": "dotnet run --project projects/cli/src/Lunapack.Cli/Lunapack.Cli.csproj --",
    "website": "npm run --prefix projects/website start",
    "build:cli": "dotnet build projects/cli/src/Lunapack.slnx",
    "build:pitch": "marp docs/pitch/business-pitch.md --html --output docs/pitch/business-pitch.html && marp docs/pitch/tech-pitch.md --html --output docs/pitch/tech-pitch.html",
    "format": "npm run format:csharp && npm run format:docs && npm run format:prettier",
    "format:csharp": "dotnet format style projects/cli/src/Lunapack.slnx --severity info && dotnet csharpier format projects",
    "format:docs": "markdownlint --fix \"README.md\" \"CONTRIBUTING.md\" \"CODE_OF_CONDUCT.md\" \"SECURITY.md\" \"SUPPORT.md\" \"docs/**/*.md\"",
    "format:prettier": "prettier --write \"**/*.{json,css,scss,html,yml,yaml}\"",
    "lint": "npm run lint:docs",
    "lint:docs": "markdownlint \"README.md\" \"CONTRIBUTING.md\" \"CODE_OF_CONDUCT.md\" \"SECURITY.md\" \"SUPPORT.md\" \"docs/**/*.md\"",
    "prepare": "husky && dotnet tool restore"
  },
  "lint-staged": {
    "*.cs": [
      "dotnet format style projects/cli/src/Lunapack.slnx --severity info --include",
      "dotnet csharpier format"
    ],
    "docs/**/*.md": "markdownlint --fix",
    "*.{json,css,scss,html,yml,yaml,md}": "prettier --write"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.6",
    "prettier-config-standard": "7.0.0"
  }
}
