{
  "name": "@lunaris/lunapack",
  "version": "0.1.0",
  "private": true,
  "description": "LunaPack is a CLI for managing and consuming packs of reusable content.",
  "scripts": {
    "cli": "dotnet run --project projects/cli/src/Lunapack.Cli/Lunapack.Cli.csproj --",
    "website": "npm run --prefix projects/website start",
    "build:cli": "dotnet build projects/cli/src/Lunapack.slnx",
    "build:pitch": "marp docs/pitch/business-pitch.md --html --output docs/pitch/business-pitch.html \u0026\u0026 marp docs/pitch/tech-pitch.md --html --output docs/pitch/tech-pitch.html",
    "format": "npm run format:csharp \u0026\u0026 npm run format:docs \u0026\u0026 npm run format:prettier",
    "format:csharp": "dotnet format style projects/cli/src/Lunapack.slnx --severity info \u0026\u0026 dotnet csharpier format projects",
    "format:docs": "markdownlint --fix \u0022README.md\u0022 \u0022CONTRIBUTING.md\u0022 \u0022CODE_OF_CONDUCT.md\u0022 \u0022SECURITY.md\u0022 \u0022SUPPORT.md\u0022 \u0022docs/**/*.md\u0022",
    "format:prettier": "prettier --write \u0022**/*.{json,css,scss,html,yml,yaml}\u0022",
    "lint": "npm run lint:docs",
    "lint:docs": "markdownlint \u0022README.md\u0022 \u0022CONTRIBUTING.md\u0022 \u0022CODE_OF_CONDUCT.md\u0022 \u0022SECURITY.md\u0022 \u0022SUPPORT.md\u0022 \u0022docs/**/*.md\u0022",
    "prepare": "husky"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.5.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "markdownlint-cli": "0.49.1",
    "prettier": "3.9.6",
    "prettier-config-standard": "7.0.0"
  },
  "lint-staged": {
    "*.cs": [
      "dotnet format style projects/cli/src/Lunapack.slnx --severity info --include",
      "dotnet csharpier format"
    ],
    "*.{md,mdx}": "markdownlint --fix",
    "*.json": "prettier --write",
    "*.html": "prettier --write",
    "*.{yml,yaml}": "prettier --write"
  }
}
