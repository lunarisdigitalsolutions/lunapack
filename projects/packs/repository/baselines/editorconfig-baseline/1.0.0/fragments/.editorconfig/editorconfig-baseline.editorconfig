# BEGIN LunaPack general EditorConfig
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{md,mdx}]
max_line_length = off
trim_trailing_whitespace = false

[*.{json,xml,yml,yaml}]
indent_size = 2
# END LunaPack general EditorConfig
