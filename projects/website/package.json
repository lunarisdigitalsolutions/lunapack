{
  "name": "@lunaris/lunapack-developer-site",
  "version": "0.1.0",
  "private": true,
  "description": "LunaPack developer documentation website.",
  "scripts": {
    "prepare:changelog": "node src/scripts/prepare-cli-changelog.mjs",
    "test:changelog": "node --test src/scripts/prepare-cli-changelog.test.mjs",
    "start": "npm run prepare:changelog && docusaurus start src",
    "build": "npm run prepare:changelog && docusaurus build src",
    "serve": "docusaurus serve src",
    "clear": "docusaurus clear src"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
