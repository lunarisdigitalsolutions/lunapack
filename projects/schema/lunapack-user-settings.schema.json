{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lunapack.dev/schema/lunapack-user-settings.schema.json",
  "title": "LunaPack user settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "$ref": "#/definitions/userTrust"
    },
    "projects": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$))(?:/|[A-Za-z]:[\\/]|\\\\).*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/localProjectTrust"
      }
    }
  },
  "definitions": {
    "ociRegistryOrigin": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]://(?:\\[[A-Fa-f0-9:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\\.?)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$"
    },
    "ociRepositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*$"
    },
    "ociSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": {
          "enum": ["oci"]
        },
        "url": {
          "$ref": "#/definitions/ociRegistryOrigin"
        },
        "path": {
          "$ref": "#/definitions/ociRepositoryPath"
        }
      }
    },
    "configuredSourceIdentity": {
      "oneOf": [
        { "$ref": "#/definitions/localSourceIdentity" },
        { "$ref": "#/definitions/gitSourceIdentity" },
        { "$ref": "#/definitions/ociSourceIdentity" }
      ]
    },
    "gitSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "path": {
          "$ref": "#/definitions/repositoryRelativePath"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["git"]
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localProjectTrust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acknowledgements": {
          "$ref": "#/definitions/trustAcknowledgements"
        },
        "deny": {
          "$ref": "#/definitions/scriptDenial"
        },
        "preferences": {
          "$ref": "#/definitions/cliPreferences"
        },
        "packs": {
          "$ref": "#/definitions/trustedPacks"
        },
        "sources": {
          "$ref": "#/definitions/trustedSources"
        }
      }
    },
    "scriptDenial": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scripts": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "localSourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "path": {
          "$ref": "#/definitions/canonicalAbsolutePath"
        },
        "type": {
          "enum": ["local"]
        }
      }
    },
    "trustedPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^@]+$"
        },
        "source": {
          "$ref": "#/definitions/configuredSourceIdentity"
        }
      }
    },
    "trustedPacks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/trustedPack"
      }
    },
    "trustedSources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/configuredSourceIdentity"
      }
    },
    "trustAcknowledgements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packs": {
          "$ref": "#/definitions/trustedPacks"
        },
        "sources": {
          "$ref": "#/definitions/trustedSources"
        }
      }
    },
    "userTrust": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deny": {
          "$ref": "#/definitions/scriptDenial"
        },
        "preferences": {
          "$ref": "#/definitions/cliPreferences"
        },
        "packs": {
          "$ref": "#/definitions/trustedPacks"
        },
        "sources": {
          "$ref": "#/definitions/trustedSources"
        }
      }
    },
    "canonicalAbsolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$))(?:/|[A-Za-z]:[\\/]|\\\\).*$"
    },
    "cliPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discover": {
          "$ref": "#/definitions/catalogPreferences"
        },
        "git": {
          "$ref": "#/definitions/gitPreferences"
        },
        "search": {
          "$ref": "#/definitions/catalogPreferences"
        },
        "nextSteps": {
          "$ref": "#/definitions/nextStepPreferences"
        },
        "resourceLimits": {
          "$ref": "#/definitions/userResourceLimits"
        }
      }
    },
    "userResourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectManifestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "packManifestBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "lockFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "packDocumentBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "packSnapshotBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "renderedFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "renderedTotalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "dependencyDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "dependencyNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "dependencyReferences": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "filesPerPack": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "filesPerGraph": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "ociArchiveEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "ociDownloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "ociEntryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "ociExpandedBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        }
      }
    },
    "gitPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowInsecureTransport": {
          "type": "boolean"
        }
      }
    },
    "catalogPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onlyComposites": {
          "type": "boolean"
        }
      }
    },
    "nextStepPreferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\/])(?![\\/])(?!.*(?:^|[\\/])\\.\\.(?:[\\/]|$)).+"
    }
  }
}
