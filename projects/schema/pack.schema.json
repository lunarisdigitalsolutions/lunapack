{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lunapack.dev/schema/pack.schema.json",
  "title": "LunaPack pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["author", "id", "license", "version"],
  "properties": {
    "author": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "draft": {
      "type": "boolean",
      "default": false
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "homepage": {
      "type": "string",
      "minLength": 1,
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^\\s/?#]+(?:[/?#][^\\s]*)?$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/parameter"
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "managedFiles": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/managedFile"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/packReference"
      }
    },
    "hooks": {
      "$ref": "#/definitions/lifecycleHooks"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/packSource"
      }
    }
  },
  "definitions": {
    "instructionHook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "file"],
      "properties": {
        "type": {
          "enum": ["instruction"]
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+\\.md$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "templating": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "lifecycleHook": {
      "oneOf": [
        {
          "$ref": "#/definitions/scriptHook"
        },
        {
          "$ref": "#/definitions/instructionHook"
        }
      ]
    },
    "lifecycleHooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postInstall": {
          "$ref": "#/definitions/lifecycleHookList"
        },
        "postUninstall": {
          "$ref": "#/definitions/lifecycleHookList"
        },
        "postUpdate": {
          "$ref": "#/definitions/lifecycleHookList"
        },
        "preInstall": {
          "$ref": "#/definitions/lifecycleHookList"
        },
        "preUninstall": {
          "$ref": "#/definitions/lifecycleHookList"
        },
        "preUpdate": {
          "$ref": "#/definitions/lifecycleHookList"
        }
      }
    },
    "lifecycleHookList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/lifecycleHook"
      }
    },
    "managedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "oneOf": [
        {
          "required": ["path"],
          "not": {
            "anyOf": [{ "required": ["glob"] }, { "required": ["directory"] }]
          }
        },
        {
          "required": ["glob"],
          "not": {
            "anyOf": [{ "required": ["path"] }, { "required": ["directory"] }]
          }
        },
        {
          "required": ["directory"],
          "not": {
            "anyOf": [{ "required": ["path"] }, { "required": ["glob"] }]
          }
        },
        {
          "required": ["source"],
          "not": {
            "anyOf": [
              { "required": ["path"] },
              { "required": ["glob"] },
              { "required": ["directory"] }
            ]
          }
        }
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/sourceRelativePattern"
          }
        },
        "flatten": {
          "type": "boolean",
          "default": false
        },
        "glob": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/definitions/sourceRelativePath"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "strategy": {
          "$ref": "#/definitions/managedFileStrategy"
        },
        "template": {
          "type": "boolean",
          "default": false
        },
        "target": {
          "$ref": "#/definitions/sourceRelativePath"
        }
      }
    },
    "packSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url", "ref"],
      "properties": {
        "type": {
          "enum": ["git"]
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!.*://[^/@]*:[^/@]*@)(?![Hh][Tt][Tt][Pp][Ss]?://[^/@]*@)(?!.*\\$\\{)(?:[Hh][Tt][Tt][Pp][Ss]?://|[Ss][Ss][Hh]://|[A-Za-z0-9._-]+@)[^\\s]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/definitions/sourceRelativePath"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "sourceRelativePattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"
    },
    "managedFileStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "method"],
      "properties": {
        "type": {
          "enum": ["copy", "merge"]
        },
        "method": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "type": {
              "enum": ["copy"]
            },
            "method": {
              "enum": [
                "overwrite",
                "fail-if-exists",
                "skip-if-exists",
                "backup-and-overwrite"
              ]
            }
          }
        },
        {
          "properties": {
            "type": {
              "enum": ["merge"]
            },
            "method": {
              "enum": ["lines", "section", "json"]
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "default": {
          "oneOf": [
            { "type": "string" },
            { "type": "boolean" },
            { "$ref": "#/definitions/stringArray" }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "multiple": {
          "type": "boolean",
          "default": false
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "type": {
          "enum": ["string", "bool", "enum"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "default": {
              "type": "string"
            },
            "type": {
              "enum": ["enum"]
            },
            "multiple": {
              "enum": [false]
            }
          },
          "required": ["values"]
        },
        {
          "properties": {
            "default": {
              "$ref": "#/definitions/stringArray"
            },
            "type": {
              "enum": ["enum"]
            },
            "multiple": {
              "enum": [true]
            }
          },
          "required": ["values", "multiple"]
        },
        {
          "properties": {
            "default": {
              "type": "string"
            },
            "type": {
              "enum": ["string"]
            }
          },
          "not": {
            "anyOf": [{ "required": ["values"] }, { "required": ["multiple"] }]
          }
        },
        {
          "properties": {
            "default": {
              "type": "boolean"
            },
            "type": {
              "enum": ["bool"]
            }
          },
          "not": {
            "anyOf": [{ "required": ["values"] }, { "required": ["multiple"] }]
          }
        }
      ]
    },
    "packReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "disabledHooks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "preInstall",
              "postInstall",
              "preUpdate",
              "postUpdate",
              "preUninstall",
              "postUninstall"
            ]
          }
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "boolean" },
              { "$ref": "#/definitions/stringArray" }
            ]
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scriptHook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["script"]
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
        },
        "runner": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": ["file", "runner"],
          "not": {
            "required": ["command"]
          }
        },
        {
          "required": ["command"],
          "not": {
            "anyOf": [{ "required": ["file"] }, { "required": ["runner"] }]
          }
        }
      ]
    }
  }
}
